# Copy to .env for local development. Every setting is optional.

# MOMATO_ENVIRONMENT=development
# MOMATO_DATA_DIR=./var
# MOMATO_DATABASE_URL=sqlite:///./var/momato.sqlite3
# MOMATO_DATABASE_URL=mssql+pyodbc://user:password@server/momato?driver=ODBC+Driver+18+for+SQL+Server
# MOMATO_AUTO_MIGRATE=true
# MOMATO_INITIAL_ADMIN_PASSWORD=change-me
# MOMATO_COOKIE_SECURE=true
# MOMATO_TRUSTED_PROXIES=127.0.0.1,::1
# MOMATO_PROFILE=default
# MOMATO_BASE_PATH=/momato/
# MOMATO_HOST=127.0.0.1
# MOMATO_PORT=8000
# Pretend it is this date (D-027); for tests and frozen demos only. Tests use 2026-10-08.
# MOMATO_TODAY=2026-10-08

# ---- Single sign-on (opt-in; see docs/AUTH.md)
# MOMATO_PUBLIC_URL=https://momato.corp.example/momato/
# MOMATO_SSO_UNKNOWN_USERS=reject
# MOMATO_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# MOMATO_OIDC_CLIENT_ID=
# MOMATO_OIDC_CLIENT_SECRET=
# MOMATO_OIDC_SUBJECT_CLAIM=oid
# MOMATO_WINDOWS_AUTH=true
# MOMATO_TRUSTED_HEADER=X-Remote-User
# MOMATO_TLS_CERTFILE=
# MOMATO_TLS_KEYFILE=
